# .env.example
DATABASE_URL=            # provisioned by: vercel integration add neon
BLOB_READ_WRITE_TOKEN=   # provisioned by: vercel blob store add
ADMIN_PASSWORD=          # openssl rand -hex 16 — must be random, at least 32 hex chars; there is no rate limit
SESSION_SECRET=          # openssl rand -hex 32
CRON_SECRET=             # openssl rand -hex 32
IG_USER_ID=              # leave empty until the Instagram account exists
IG_ACCESS_TOKEN=         # leave empty until the Instagram account exists
GRAPH_BASE=              # pins the Graph API version, e.g. https://graph.facebook.com/v25.0 — leave empty to use the built-in default

ALLOW_DRYRUN_PUBLISH=    # set to 1 to let the scheduler pretend to post — it CONSUMES the queue and deletes the originals
